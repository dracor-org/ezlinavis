  "scripts": {
    "grammar": "nearleyc src/grammar.ne -o src/grammar.js",
    "dev": "pnpm run grammar && vite",
    "build": "pnpm run grammar && vite build",
    "start": "pnpm run dev",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "preview": "pnpm run grammar && vite preview"
